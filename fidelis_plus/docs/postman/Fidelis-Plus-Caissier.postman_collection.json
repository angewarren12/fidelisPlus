{
  "info": {
    "_postman_id": "fidelis-plus-caissier-v1",
    "name": "Fidelis Plus — App caisse (mobile)",
    "description": "Flux Sanctum : login, stations, scan fidélité (Idempotency-Key), notifications.\nOpenAPI : docs/openapi/fidelis-plus-v1.yaml\nDoc : docs/api/caissier-postman-curl.md",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "token", "value": "" },
    { "key": "station_id", "value": "1" },
    { "key": "qr_payload", "value": "COLLEZ_ICI_LE_PAYLOAD_QR" },
    { "key": "idempotency_key", "value": "{{$guid}}" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST login (remplit token via Tests)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json && json.data && json.data.token) {",
                  "  pm.collectionVariables.set('token', json.data.token);",
                  "}",
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"caisse@mayelia.test\",\n  \"password\": \"caisse2026\"\n}"
            },
            "url": "{{base_url}}/api/v1/auth/login"
          }
        },
        {
          "name": "GET me",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/auth/me"
          }
        },
        {
          "name": "POST logout",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/auth/logout"
          }
        },
        {
          "name": "PATCH fcm-token",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "PATCH",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fcm_token\": \"OPTIONNEL_DEVICE_TOKEN\"\n}"
            },
            "url": "{{base_url}}/api/v1/auth/fcm-token"
          }
        }
      ]
    },
    {
      "name": "Caisse fidélité",
      "item": [
        {
          "name": "GET stations",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/stations"
          }
        },
        {
          "name": "POST loyalty/pos/scan",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotency_key}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"qr_payload\": \"{{qr_payload}}\",\n  \"station_id\": {{station_id}},\n  \"occurred_at\": \"2026-05-06T12:00:00+02:00\",\n  \"device_id\": \"postman-test\"\n}"
            },
            "url": "{{base_url}}/api/v1/loyalty/pos/scan"
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "GET notifications",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/notifications?per_page=20"
          }
        },
        {
          "name": "GET notifications/unread-count",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/notifications/unread-count"
          }
        },
        {
          "name": "PATCH notifications/mark-all-read",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "PATCH",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/notifications/mark-all-read"
          }
        }
      ]
    }
  ]
}
