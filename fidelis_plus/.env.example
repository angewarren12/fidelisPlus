APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Origines CORS (SPA Angular / WebViews). Apps natives Flutter : pas de CORS.
# Liste séparée par des virgules. Défaut interne : localhost:4200 si absent.
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Domaines « stateful » Sanctum (cookies session). Pour token Bearer pur (mobile), peu utilisé.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:4200,127.0.0.1

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
PUSHER_APP_ID=fidelis
PUSHER_APP_KEY=local
PUSHER_APP_SECRET=local
PUSHER_HOST=127.0.0.1
PUSHER_PORT=6001
PUSHER_SCHEME=http
PUSHER_APP_CLUSTER=mt1
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Mobile/Web push (optionnel)
FCM_SERVER_KEY=

# Fidélité — chiffrement des QR cartes (clé longue aléatoire en prod, distincte d'APP_KEY)
LOYALTY_QR_KEY=
LOYALTY_POS_POINTS_PER_SCAN=10
LOYALTY_QR_TTL_SECONDS=31536000

# Intégration app mobile client SIRA (jeton de service partagé)
SIRA_API_TOKEN=

# Appels sortants Fidelis -> SIRA (vérification/provisioning de compte)
SIRA_OUTBOUND_BASE_URL=
SIRA_OUTBOUND_TOKEN=

# Appels sortants Fidelis -> Odoo, y compris le cron de pull (prospects/clients/flottes/
# devis créés, modifiés, archivés) — voir app/Console/Commands/SyncFromOdoo.php
ODOO_OUTBOUND_BASE_URL=
ODOO_OUTBOUND_TOKEN=

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Shared secret with GitHub Actions DEPLOY_TOKEN for post-deploy webhook authentication
DEPLOY_TOKEN=

